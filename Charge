        const plansContainer = document.getElementById('plansContainer');
        const companyFilter = document.getElementById('companyFilter');
        const durationFilter = document.getElementById('durationFilter');
        const whatsappNumber = '972594882070';

        function renderPlans() {
            const selectedCompany = companyFilter.value;
            const selectedDuration = durationFilter.value;

            const filtered = plans.filter(plan => {
                const companyMatch = selectedCompany === 'all' || plan.company === selectedCompany;
                const durationMatch = selectedDuration === 'all' || plan.duration === selectedDuration;
                return companyMatch && durationMatch;
            });

            plansContainer.innerHTML = '';

            if (filtered.length === 0) {
                plansContainer.innerHTML = `<div class="no-plans"><i class="fa-solid fa-circle-exclamation"></i>لا توجد باقات تطابق الفلتر المحدد</div>`;
                return;
            }

            filtered.forEach(plan => {
                const card = document.createElement('div');
                card.className = `plan-card ${plan.featured ? 'featured' : ''}`;
                card.innerHTML = `
                    <span class="company-badge ${plan.badge}">${plan.company}</span>
                    <div class="plan-name">${plan.name}</div>
                    <div class="plan-data"><i class="fa-solid fa-wifi"></i> ${plan.data}</div>
                    <div class="plan-duration"><i class="fa-regular fa-clock"></i> ${plan.duration}</div>
                    <div class="price-tag">${plan.price} <span class="currency">${plan.currency}</span></div>
                    <button class="btn-select" onclick="selectPlan('${plan.whatsappMsg.replace(/'/g, "\\'")}')">
                        <i class="fa-brands fa-whatsapp"></i> اختيار الشريحة
                    </button>
                `;
                plansContainer.appendChild(card);
            });
        }

        function selectPlan(message) {
            const url = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message + ' — من متجر شحن بلس')}`;
            window.open(url, '_blank');
        }

        function submitOrder() {
            const name = document.getElementById('fullName').value.trim();
            const phone = document.getElementById('phone').value.trim();
            const whatsapp = document.getElementById('whatsapp').value.trim();
            const area = document.getElementById('area').value;
            const notes = document.getElementById('notes').value.trim();

            if (!name || !phone) {
                alert('⚠️ الرجاء إدخال الاسم الكامل ورقم الجوال على الأقل');
                return;
            }

            let message = `🛒 *طلب جديد من متجر شحن بلس*%0A%0A`;
            message += `👤 *الاسم:* ${name}%0A`;
            message += `📱 *رقم الجوال:* ${phone}%0A`;
            if (whatsapp && whatsapp !== '+972') message += `💬 *الواتساب:* ${whatsapp}%0A`;
            if (area) message += `📍 *المنطقة:* ${area}%0A`;
            if (notes) message += `📝 *ملاحظات:* ${notes}%0A`;
            message += `%0A💵 *الدفع عند الاستلام*`;

            const url = `https://wa.me/${whatsappNumber}?text=${message}`;
            window.open(url, '_blank');
        }

        companyFilter.addEventListener('change', renderPlans);
        durationFilter.addEventListener('change', renderPlans);
        renderPlans();
    </script>
